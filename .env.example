# 复制为 .env 并填写真实值。未配置 SMTP 时，系统会把邮件落盘到 data/outbox 以便预览。

# 服务端口
PORT=3000

# 收件邮箱（你的邮箱，下单后备菜通知发送到这里）
NOTIFY_EMAIL=you@example.com

# SMTP 发信配置（以 Gmail 为例，需使用应用专用密码）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_account@gmail.com
SMTP_PASS=your_app_password
# 发件人显示地址（可选，默认用 SMTP_USER）
SMTP_FROM=家庭点餐系统 <your_account@gmail.com>

# 每周餐单邮件定时发送（默认：周六 17:00，香港时区 UTC+8）
# 不再每次保存就发邮件，而是统一在每周六下午 5 点发送「下周一至周五」的餐单与备菜清单。
# WEEKLY_SEND_ENABLED=true
# WEEKLY_SEND_DOW=6          # 0=周日 … 6=周六
# WEEKLY_SEND_HOUR=17        # 小时（24 小时制）
# WEEKLY_SEND_MINUTE=0
# WEEKLY_SEND_TZ_OFFSET=480  # 相对 UTC 的分钟偏移，UTC+8=480

# 可选：自定义食谱库 / 订单存储路径
# RECIPES_PATH=./data/recipes.json
# ORDERS_PATH=./data/orders.json
